{{ form_start(form) }}
{{ form_row(form.name)}}
{{ form_row(form.description)}}
<div class="row">
    <div class="col">
    {{ form_row(form.price)}}
    </div>
    <div class="col">
    {{ form_row(form.type)}}
    </div>
</div>
<div class="row">
    <div class="col">
    {{ form_row(form.credit)}}
    </div>
    <div class="col">
    {{ form_row(form.status)}}
    </div>
</div>
<div style="display:none;">
    {{ form_widget(form) }}
</div>
    <button class="btn btn-primary px-5 rounded-pill my-4"><i class="bi me-2 bi-save"></i>{{ button_label|default('Save') }}</button>
{{ form_end(form) }}
