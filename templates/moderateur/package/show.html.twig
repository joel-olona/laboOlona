{% extends 'dashboard/base.html.twig' %}

{% block title %}Package{% endblock %}

{% block body %}
<section class="p-0 m-0">
    <div class="container">
        <div class="row p-4 pb-0 pe-lg-0 pt-lg-5 align-items-center">
            <div class="row mb-3">
                <h1 class="h3">{{ package.name }}</h1>

                <table class="table">
                    <tbody>
                        <tr>
                            <th>Id</th>
                            <td>{{ package.id }}</td>
                        </tr>
                        <tr>
                            <th>Name</th>
                            <td>{{ package.name }}</td>
                        </tr>
                        <tr>
                            <th>Slug</th>
                            <td>{{ package.slug }}</td>
                        </tr>
                        <tr>
                            <th>Description</th>
                            <td>{{ package.description }}</td>
                        </tr>
                        <tr>
                            <th>Credit</th>
                            <td>{{ package.credit }}</td>
                        </tr>
                        <tr>
                            <th>Price</th>
                            <td>{{ package.price }}</td>
                        </tr>
                        <tr>
                            <th>UpdatedAt</th>
                            <td>{{ package.updatedAt ? package.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
                        </tr>
                        <tr>
                            <th>Type</th>
                            <td>{{ package.type }}</td>
                        </tr>
                        <tr>
                            <th>Status</th>
                            <td>{{ package.status }}</td>
                        </tr>
                    </tbody>
                </table>
                <div class="d-flex justify-content-end w-100">
                    <a class="btn btn-secondary px-5 rounded-pill" href="{{ path('app_moderateur_package_edit', {'id': package.id}) }}"><i class="bi me-2 bi-pencil"></i>Modifier</a>
                    {{ include('moderateur/package/_delete_form.html.twig') }}
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
