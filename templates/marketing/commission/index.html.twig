{% extends 'moderateur/base.html.twig' %}

{% block title %}Toutes les commissions{% endblock %}

{% block body %}
    <div class="row mb-3">
        <div class="col">
            <h1 class="h3">Tous les commissions ({{ count }})</h1>
        </div>
        <div class="col">
            <div class="row">
                <div class="col">
                    <form action="{{ path('app_marketing_commission_index')}}" method="get">
                        <select class="form-select" name="status" onchange="this.form.submit()" aria-label="Default select example">
                            {% for label, status in statuses %}
                                <option value="{{ status }}" {% if selectedStatus == status %}selected{% endif %}>{{ label }}</option>
                            {% endfor %}
                        </select>
                    </form>
                </div>
                <div class="col-auto">
                    <span class="badge bg-success">{{ countStatus }} </span>
                </div>
            </div>
        </div>
    </div>
    {% if is_granted("ROLE_SUPER_ADMIN") %}
        <div>
            <a class="btn btn-primary my-3 px-5 rounded-pill" href="{{ path('app_marketing_commission_new') }}"><i class="bi me-2 bi-plus-lg"></i>Ajouter</a>
            <a class="btn btn-info my-3 px-5 rounded-pill" href="{{ path('app_marketing_commission_users') }}"><i class="bi me-2 bi-person-fill-down"></i>Par utilisateur</a>
        </div>
    {% endif %}

    <table class="table">
        <thead>
            <tr>
                <th>{{ knp_pagination_sortable(commissions, 'Montant', 'c.amount') }}</th>
                <th>{{ knp_pagination_sortable(commissions, 'Date', 'c.createdAt') }}</th>
                <th>{{ knp_pagination_sortable(commissions, 'Référence', 'c.saleReference') }}</th>
                <th>{{ knp_pagination_sortable(commissions, 'Type', 'c.serviceType') }}</th>
                <th>{{ knp_pagination_sortable(commissions, 'Statut', 'c.status') }}</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        {% for commission in commissions %}
            <tr>
                <td>{{ commission.amount }} Ar</td>
                <td>{{ commission.createdAt ? commission.createdAt|date('d/m/Y') : '-' }}</td>
                <td>{{ commission.saleReference }}</td>
                <td>{{ commission.typeLabels[commission.serviceType]|raw }}</td>
                <td>{{ commission.labels[commission.status]|raw }}</td>
                <td>
                    <a class="btn btn-sm rounded-cirle btn-info" href="{{ path('app_marketing_commission_show', {'id': commission.id}) }}"><i class="bi bi-eye"></i></a>
                    <a class="btn btn-sm rounded-cirle btn-danger" href="{{ path('app_marketing_commission_edit', {'id': commission.id}) }}"><i class="bi bi-pencil"></i></a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    {{ knp_pagination_render(commissions) }}

{% endblock %}
