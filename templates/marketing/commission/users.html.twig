{% extends 'moderateur/base.html.twig' %}

{% block title %}Toutes les commissions{% endblock %}

{% block body %}
    <div class="row mb-3">
            <h1 class="h3">Tous les commissions par utilisateur </h1>
        <div class="col-6">
            <div class="row">
                <div class="col">
                    <form action="{{ path('app_marketing_commission_users')}}" method="get">
                        <select class="form-select" name="status" onchange="this.form.submit()" aria-label="Default select example">
                            {% for label, status in statuses %}
                                <option value="{{ status }}" {% if selectedStatus == status %}selected{% endif %}>{{ label }}</option>
                            {% endfor %}
                        </select>
                    </form>
                </div>
                <div class="col-auto">
                    <span class="badge bg-success">{{ countStatus }} </span>
                </div>
            </div>
        </div>
    </div>

    <table class="table">
        <thead>
            <tr>
                <th>{{ knp_pagination_sortable(users, 'Nom', 'nom') }}</th>
                <th>{{ knp_pagination_sortable(users, 'Prenom', 'prenom') }}</th>
                <th>{{ knp_pagination_sortable(users, 'Montant', 'totalCommission') }}</th>
                <th>{{ knp_pagination_sortable(users, 'Statut', 'status') }}</th>
                <th>{{ knp_pagination_sortable(users, 'Nombre', 'nombre') }}</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        {% for item in users %}
            <tr>
                <td>{{ item['nom'] }}</td>
                <td>{{ item['prenom'] }}</td>
                <td>{{ item['totalCommission'] }} Ar</td>
                <td>{{ item['status'] }}</td>
                <td>{{ item['nombre'] }}</td>
                <td>
                    {# <a class="btn btn-sm rounded-cirle btn-info" href="{{ path('app_marketing_commission_show', {'id': commission.id}) }}"><i class="bi bi-eye"></i></a>
                    <a class="btn btn-sm rounded-cirle btn-danger" href="{{ path('app_marketing_commission_edit', {'id': commission.id}) }}"><i class="bi bi-pencil"></i></a> #}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    {{ knp_pagination_render(users) }}

{% endblock %}
